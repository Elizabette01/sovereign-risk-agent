st updated: 09/2024"	n/a	n/a	n/a	n/a	n/a	n/a	n/a	n/a	n/a	n/a	-25.385	-6.735	-4.555	15.085	-19.415	-14.214	-16.37	-29.762	-46.464	-95.79	-137.069	-151.268	-171.116	-177.502	-164.969	-111.967	-2.143	-35.055	-12.465	-182.225	-219.213	-33.433	-34.84	44.241	152.395	28.084	-116.906	-136.797	-278.63	-290.831	-654.622	"-1,063.63"	"-1,226.76"	"-1,075.87"	"-1,016.07"	"-1,121.65"	-928.258	-829.677	-745.261	-690.562	2023
