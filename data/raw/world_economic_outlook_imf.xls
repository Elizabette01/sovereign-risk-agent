han Shares; Loans; Other Accounts Receivable/Payable Primary domestic currency: Chinese yuan Data last updated: 09/2024"	454.052	492.16	538.632	603.423	729.014	910.808	"1,039.03"	"1,219.80"	"1,521.05"	"1,725.05"	"1,896.93"	"2,199.72"	"2,714.03"	"3,557.60"	"4,841.03"	"6,105.04"	"7,154.15"	"7,941.58"	"8,479.08"	"9,009.51"	"9,979.90"	"11,038.84"	"12,132.67"	"13,714.67"	"16,135.56"	"18,765.75"	"21,959.75"	"27,049.94"	"31,806.76"	"34,765.03"	"40,850.54"	"48,410.93"	"53,903.99"	"59,634.45"	"64,654.80"	"69,209.37"	"74,598.05"	"82,898.28"	"91,577.43"	"99,070.84"	"102,562.84"	"114,528.29"	"120,247.10"	"125,798.00"	"131,487.83"	"139,955.30"	"148,580.92"	"156,924.05"	"165,457.60"	"174,297.21"	2023
